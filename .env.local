DJANGO_SETTINGS_MODULE=config.settings.local


GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH= "path/to/key.pem"
GITHUB_APP_NAME=name_of_app

AWS_ACCESS_KEY_ID=you_aws_access_key_id
AWS_SECRET_ACCESS_KEY=aws_secret_access_key

STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLIC_KEY=your_stripe_public_key

# Email settings
POSTMARK_SERVER_TOKEN=your_postmark_server_token
POSTMARK_INBOUND_SECRET=your_postmark_inbound_secret

# Google LLM setting, required or else ell failed to start
GOOGLE_API_KEY=google_gemini_api_key

# Celery Configuration
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_REDIS_PASSWORD=your_redis_password
CELERY_RESULT_BACKEND=redis://localhost:6379/0
