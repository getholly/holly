{
  "name": "holly",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:django": "./scripts/dev-with-django.sh",
    "dev:django:bash": "bash ./scripts/dev-with-django.sh",
    "build": "npm run build:svelte",
    "build:svelte": "vite build",
    "preview": "vite preview",
    "test": "npm run test:integration && npm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "prepare": "husky",
    "format:json": "prettier --check --write \"**/*.json\"",
    "format:prettier": "prettier --check --write \"**/*.{svelte,js,ts,json}\"",
    "api:update-tsconfig": "node scripts/updateTsconfigOpenapiGen.js",
    "api:fetch": "npx rimraf gen/openapi &&  npx openapi-generator-cli generate -i openapi/openapi.json -g typescript-fetch --additional-properties=typescriptThreePlus=true --skip-validate-spec --config api-fetch.json -o gen/openapi && npm run api:update-tsconfig && cd gen/openapi  && npm i && npm run build && npm pack",
    "api:install": "npm i gen/openapi/holly-api-1.0.0.tgz",
    "api:full": "node ./scripts/fetch-openapi.js && npm run api:fetch && npm run api:install && npm run format:prettier",
    "api:openapi": "./scripts/fetch-openapi.sh"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.14.0",
    "@playwright/test": "^1.28.1",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/dompurify": "^3.0.5",
    "@types/eslint": "^9.6.0",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "flowbite": "^2.5.2",
    "flowbite-svelte": "^0.47.3",
    "flowbite-svelte-icons": "^1.6.0",
    "globals": "^15.0.0",
    "highlight.run": "^8.13.0",
    "husky": "^9.1.6",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.1.2",
    "svelte": "^4.2.7",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.3",
    "vite-plugin-svelte-console-remover": "^1.0.10",
    "vitest": "^2.0.0"
  },
  "type": "module",
  "dependencies": {
    "@novnc/novnc": "^1.6.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.5",
    "dotenv": "^16.4.5",
    "flowbite-svelte-blocks": "^1.1.1",
    "flowbite-typography": "^1.0.4",
    "holly-api": "file:gen/openapi/holly-api-1.0.0.tgz",
    "js-cookie": "^3.0.5",
    "js-sha256": "^0.11.0",
    "jsdom": "^26.1.0",
    "markdown-it": "^14.1.0",
    "svelte-autosize": "^1.1.5",
    "svelte-i18n": "^4.0.1",
    "tippy.js": "^6.3.7",
    "uuid": "^11.1.0"
  }
}
