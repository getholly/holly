  "panels": [
    {
      "id": 1,
      "title": "Webdev Status",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "( (up{job=\"cadvisor\", container_label_com_docker_compose_service=\"webdev\"} == 1 AND on(instance, job, name) container_health_failing{job=\"cadvisor\", container_label_com_docker_compose_service=\"webdev\"} == 0) * 2 ) OR ( (up{job=\"cadvisor\", container_label_com_docker_compose_service=\"webdev\"} == 1 AND on(instance, job, name) container_health_failing{job=\"cadvisor\", container_label_com_docker_compose_service=\"webdev\"} == 1) * 1 ) OR ( (up{job=\"cadvisor\", container_label_com_docker_compose_service=\"webdev\"} == 0) * 0 ) OR (absent(up{job=\"cadvisor\", container_label_com_docker_compose_service=\"webdev\"}) * -1)",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-red", "value": null },
              { "color": "red", "value": 0 },      // Down
              { "color": "orange", "value": 1 },   // Starting
              { "color": "green", "value": 2 }     // Ready
            ]
          },
          "mappings": [
            { "type": "value", "options": { "-1": { "text": "Unknown", "color": "grey" } } },
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "Starting", "color": "orange" } } },
            { "type": "value", "options": { "2": { "text": "Ready", "color": "green" } } }
          ],
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Frontend Status",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "up{job=\"cadvisor\", container_label_com_docker_compose_service=\"frontend\"} OR ON() vector(0)",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "instant": true
        }
      ],
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "red", "value": 0 }, { "color": "green", "value": 1 }] },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red"} } },
            { "type": "value", "options": { "1": { "text": "Up", "color": "green"} } },
            { "type": "special", "options": { "match": "null", "result": {"text": "Unknown", "color": "grey"} } }
          ],
          "unit": "short"
        },
        "overrides": []
      }
